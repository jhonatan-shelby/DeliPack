# Copia este archivo como .env y cambia los valores. NUNCA subas .env a GitLab.

# --- Seguridad ---
# Genera una clave larga y aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=0
# Dominios desde los que se abre la página (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Dirección secreta del panel (por ejemplo: gestion-dp-2026/)
ADMIN_URL=admin/

# En tu computador (sin HTTPS) déjalos en 0. Al publicar con HTTPS ponlos en 1.
FORZAR_HTTPS=0
COOKIES_SEGURAS=0

# --- Base de datos PostgreSQL ---
DB_NAME=delipack
DB_USER=delipack
DB_PASSWORD=cambia-esta-contrasena

# --- Administrador principal (se crea la primera vez) ---
DJANGO_SUPERUSER_EMAIL=admin@delipack.ec
DJANGO_SUPERUSER_PASSWORD=Cambia#Esta2026

# --- Correo (verificación de cuentas y avisos de pedidos) ---
# Sin configurar, los correos se muestran en la terminal (docker compose logs web).
# Ejemplo con Gmail (necesita una "contraseña de aplicación"):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=tucorreo@gmail.com
# EMAIL_HOST_PASSWORD=contrasena-de-aplicacion
# DEFAULT_FROM_EMAIL=DeliPack <tucorreo@gmail.com>

# --- Datos del negocio que aparecen en la página ---
NEGOCIO_TELEFONO=+593 99 000 0000
NEGOCIO_CORREO=pedidos@delipack.ec

# Puerto en tu computador: http://localhost:8080
PUERTO=8080
